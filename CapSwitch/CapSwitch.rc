#include "resource.h"
#include "version.h"
#include <winres.h>

IDI_CAPSWITCH ICON "CapSwitch.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CAPSWITCH_VERSION_TUPLE
 PRODUCTVERSION CAPSWITCH_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "CapSwitch - keyboard layout switcher"
            VALUE "FileVersion", CAPSWITCH_VERSION_STRING
            VALUE "InternalName", "CapSwitch"
            VALUE "OriginalFilename", "CapSwitch.exe"
            VALUE "ProductName", "CapSwitch"
            VALUE "ProductVersion", CAPSWITCH_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
